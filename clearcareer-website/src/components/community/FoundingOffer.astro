---
interface Props {
  joinUrl: string;
}
const { joinUrl } = Astro.props;

const stack = [
  { item: "Weekly group coaching calls with Izzy", value: "$400/mo" },
  { item: "Done-for-you template vault", value: "$300" },
  { item: "Private community of peers", value: "$150/mo" },
  { item: "Monthly live workshops", value: "$250/mo" },
  { item: "The full resource library", value: "$200" },
  { item: "AI prompt vault (30+ prompts)", value: "$100" },
];
---

<section id="pricing" class="relative overflow-hidden bg-gradient-to-b from-white to-blue-bg/50 py-20 md:py-28">
  <div class="mx-auto max-w-[640px] px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <p data-cc-fade class="inline-flex items-center gap-2 rounded-full bg-warning/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-warning">
        Founding member relaunch
      </p>
      <h2 data-cc-fade class="mx-auto mt-5 max-w-[18ch] font-display text-[clamp(2rem,4vw,3rem)] leading-[1.05] text-navy">
        Lock in $29/mo before the price rises
      </h2>
      <p data-cc-fade class="mx-auto mt-4 max-w-[46ch] text-[1.0625rem] leading-relaxed text-text-muted">
        Founding members keep this rate for life. When the doors reopen, it goes back to $49/mo.
      </p>
    </div>

    <div data-cc-fade class="relative mt-12 overflow-hidden rounded-[2rem] border border-blue/20 bg-white p-8 shadow-card-hover sm:p-10">
      <div class="absolute -right-16 -top-16 h-48 w-48 rounded-full bg-blue/10 blur-3xl" aria-hidden="true"></div>

      <div class="relative flex items-end justify-center gap-3">
        <span class="font-display text-6xl leading-none text-navy">$29</span>
        <span class="pb-2 text-lg text-text-muted">/month</span>
        <span class="pb-2 text-lg text-text-muted line-through decoration-warning/70">$49</span>
      </div>
      <p class="relative mt-2 text-center text-sm font-medium text-success">That's about $0.97 a day.</p>

      <ul class="relative mt-8 space-y-3">
        {stack.map((s) => (
          <li class="flex items-center justify-between gap-4 border-b border-border/70 pb-3 text-left last:border-0">
            <span class="flex items-start gap-2.5 text-[0.975rem] text-text">
              <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 6L9 17l-5-5" />
              </svg>
              {s.item}
            </span>
            <span class="whitespace-nowrap text-sm text-text-muted line-through">{s.value}</span>
          </li>
        ))}
      </ul>

      <div class="relative mt-6 rounded-xl bg-blue-bg p-4 text-center">
        <p class="text-sm text-text-muted">
          Over <span class="font-semibold text-navy">$1,400/mo</span> of value. Yours for <span class="font-semibold text-blue">$29</span>.
        </p>
      </div>

      <a
        href={joinUrl}
        data-magnetic
        class="group relative mt-8 flex w-full items-center justify-center gap-2 rounded-full bg-blue px-8 py-4 text-base font-semibold text-white shadow-glow transition-colors hover:bg-blue-dark"
      >
        Become a founding member
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>

      <p class="relative mt-4 flex items-center justify-center gap-2 text-center text-sm text-text-muted">
        <svg class="h-4 w-4 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        Cancel anytime. Stay because it works, not because you're locked in.
      </p>
    </div>
  </div>
</section>
