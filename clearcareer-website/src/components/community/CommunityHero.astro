---
interface Props {
  joinUrl: string;
}
const { joinUrl } = Astro.props;
---

<section class="cc-hero relative flex min-h-[100svh] items-center overflow-hidden bg-navy">
  <!-- CSS gradient fallback (always painted; WebGL canvas layers on top when available) -->
  <div class="cc-hero-fallback absolute inset-0" aria-hidden="true"></div>
  <canvas id="cc-hero-canvas" class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-1000" aria-hidden="true"></canvas>
  <div class="cc-hero-veil absolute inset-0" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1100px] px-4 py-32 text-center sm:px-6 lg:px-8">
    <p data-cc-fade class="mx-auto inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-white/80 backdrop-blur-sm">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-teal"></span>
      </span>
      Now enrolling founding members
    </p>

    <h1 class="mx-auto mt-8 max-w-[24ch] font-display text-[clamp(2.6rem,7vw,5rem)] leading-[0.98] text-white">
      <span data-cc-reveal class="block">The career coaching community</span>
      <span data-cc-reveal class="block bg-gradient-to-r from-blue-light via-white to-teal bg-clip-text text-transparent">that lands your next role.</span>
    </h1>

    <p data-cc-fade data-cc-delay="200" class="mx-auto mt-8 max-w-[58ch] text-lg leading-relaxed text-white/70 sm:text-xl">
      Weekly group coaching with Izzy, the templates behind five-figure raises, and a private crew of
      professionals job searching right alongside you. Land your next role faster, together.
    </p>

    <div data-cc-fade data-cc-delay="350" class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href={joinUrl}
        data-magnetic
        class="group inline-flex items-center gap-2 rounded-full bg-white px-8 py-4 text-base font-semibold text-navy shadow-[0_0_50px_-8px_rgba(120,170,255,0.7)] transition-colors hover:bg-blue hover:text-white"
      >
        Join for $29/mo
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
      <a href="#inside" class="inline-flex items-center gap-2 rounded-full border border-white/20 px-8 py-4 text-base font-semibold text-white transition-colors hover:bg-white/10">
        See what's inside
      </a>
    </div>

    <p data-cc-fade data-cc-delay="500" class="mt-6 text-sm text-white/50">
      Lock in $29/mo for life · Before it returns to $49 · Cancel anytime
    </p>
  </div>

  <!-- scroll cue -->
  <div class="absolute bottom-8 left-1/2 z-10 -translate-x-1/2" aria-hidden="true">
    <div class="flex h-10 w-6 items-start justify-center rounded-full border border-white/30 p-1.5">
      <span class="cc-scroll-dot h-2 w-1 rounded-full bg-white/70"></span>
    </div>
  </div>
</section>

<style>
  .cc-hero-fallback {
    background:
      radial-gradient(60% 50% at 50% 30%, rgba(1, 97, 239, 0.45) 0%, transparent 60%),
      radial-gradient(50% 60% at 80% 80%, rgba(6, 182, 212, 0.35) 0%, transparent 55%),
      radial-gradient(70% 70% at 15% 75%, rgba(59, 130, 246, 0.3) 0%, transparent 60%),
      #030620;
  }
  #cc-hero-canvas.is-active {
    opacity: 1;
  }
  .cc-hero-veil {
    background: radial-gradient(75% 75% at 50% 45%, transparent 30%, rgba(3, 6, 32, 0.55) 100%);
  }
  .cc-scroll-dot {
    animation: cc-scroll 1.8s ease-in-out infinite;
  }
  @keyframes cc-scroll {
    0% { transform: translateY(0); opacity: 0; }
    30% { opacity: 1; }
    100% { transform: translateY(14px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cc-scroll-dot { animation: none; }
  }
</style>
