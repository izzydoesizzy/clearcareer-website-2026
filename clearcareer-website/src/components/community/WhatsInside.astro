---
interface Props {
  joinUrl: string;
}
const { joinUrl } = Astro.props;

const cards = [
  {
    n: "01",
    title: "Weekly Group Coaching",
    body: "Live calls with Izzy every week. Bring the offer, the rejection, the stuck point. Leave with a plan and people in your corner.",
    icon: "calls",
  },
  {
    n: "02",
    title: "Done-For-You Templates",
    body: "Resumes, outreach scripts, follow-up emails, and negotiation frameworks that have helped members add five figures to offers.",
    icon: "templates",
  },
  {
    n: "03",
    title: "A Private Room of Peers",
    body: "Professionals navigating the exact same wall you are. Share wins, get feedback fast, and never search in silence again.",
    icon: "people",
  },
  {
    n: "04",
    title: "Monthly Deep-Dive Workshops",
    body: "LinkedIn optimization, interview rehearsal, salary negotiation. Live, recorded, and built around what members need next.",
    icon: "workshop",
  },
  {
    n: "05",
    title: "The Full Resource Library",
    body: "Every guide, calculator, and framework from the ClearCareer toolkit, organized so you can find the right move in minutes.",
    icon: "library",
  },
  {
    n: "06",
    title: "AI Prompt Vault",
    body: "30+ tested prompts for resume writing, company research, and interview prep. The unfair advantage most job seekers miss.",
    icon: "ai",
  },
];

const icons: Record<string, string> = {
  calls: `<path d="M15.05 5A5 5 0 0 1 19 8.95M15.05 1A9 9 0 0 1 23 8.94m-1 7.98v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>`,
  templates: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/>`,
  people: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>`,
  workshop: `<path d="M2 3h20v14H2z"/><path d="M8 21h8M12 17v4"/>`,
  library: `<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>`,
  ai: `<path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/><circle cx="12" cy="12" r="3"/>`,
};
---

<section id="inside" data-cc-horizontal class="cc-inside relative bg-white md:h-screen md:overflow-hidden">
  <div
    data-cc-track
    class="flex flex-col gap-6 px-4 py-20 sm:px-6 md:h-screen md:flex-row md:flex-nowrap md:items-center md:gap-8 md:py-0 md:pl-[8vw] md:pr-[8vw]"
  >
    <!-- intro panel -->
    <div class="flex shrink-0 flex-col justify-center md:h-screen md:w-[34vw] md:min-w-[420px] md:pr-6">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue">What's inside</p>
      <h2 class="mt-4 font-display text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.05] text-navy">
        Everything your job search needs.<br />Plus the people you've been missing.
      </h2>
      <p class="mt-5 max-w-[42ch] text-[1.0625rem] leading-[1.75] text-text-muted">
        Six things that turn a lonely, grinding search into a system with real momentum and people in your corner.
      </p>
      <p class="mt-6 hidden items-center gap-2 text-sm font-medium text-blue md:flex">
        Scroll to explore
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </p>
    </div>

    <!-- benefit panels -->
    {cards.map((c) => (
      <article
        data-cc-tilt
        class="group relative flex shrink-0 flex-col justify-between overflow-hidden rounded-3xl border border-border bg-gradient-to-br from-white to-blue-bg/40 p-8 shadow-card transition-shadow hover:shadow-card-hover md:h-[62vh] md:w-[30vw] md:min-w-[360px]"
      >
        <div class="absolute -right-6 -top-8 font-display text-[8rem] leading-none text-blue/5 transition-colors group-hover:text-blue/10">{c.n}</div>
        <div class="relative">
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-blue text-white shadow-glow">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[c.icon]} />
          </div>
          <h3 class="mt-6 text-2xl font-semibold leading-tight text-navy">{c.title}</h3>
          <p class="mt-4 text-[1.0625rem] leading-[1.7] text-text-muted">{c.body}</p>
        </div>
      </article>
    ))}

    <!-- closing CTA panel -->
    <div class="flex shrink-0 flex-col justify-center rounded-3xl bg-navy p-10 text-white md:h-[62vh] md:w-[30vw] md:min-w-[360px]">
      <h3 class="font-display text-3xl leading-tight">All of it, for less than a lunch out each week.</h3>
      <p class="mt-4 text-white/70">One membership. Every tool, call, and template the ClearCareer system runs on.</p>
      <a href={joinUrl} data-magnetic class="mt-8 inline-flex w-fit items-center gap-2 rounded-full bg-white px-7 py-3.5 font-semibold text-navy transition-colors hover:bg-blue hover:text-white">
        Join for $29/mo
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* When there is no horizontal pin to scroll the track (reduced motion or no JS),
     stack the panels vertically so every card stays reachable. */
  @media (prefers-reduced-motion: reduce) {
    .cc-inside { height: auto !important; }
    .cc-inside [data-cc-track] {
      flex-direction: column !important;
      flex-wrap: wrap !important;
      height: auto !important;
      padding: 5rem 1.5rem !important;
      gap: 1.5rem !important;
    }
    .cc-inside [data-cc-track] > * {
      width: auto !important;
      min-width: 0 !important;
      height: auto !important;
    }
  }
  html:not(.cc-js) .cc-inside { height: auto; }
  html:not(.cc-js) .cc-inside [data-cc-track] {
    flex-direction: column;
    flex-wrap: wrap;
    height: auto;
    padding: 5rem 1.5rem;
    gap: 1.5rem;
  }
  html:not(.cc-js) .cc-inside [data-cc-track] > * {
    width: auto;
    min-width: 0;
    height: auto;
  }
</style>
