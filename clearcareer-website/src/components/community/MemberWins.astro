---
import allTestimonials from "@data/testimonials.json";

interface Testimonial {
  name: string;
  role: string;
  quote: string;
  pullQuote?: string;
  tagline?: string;
  category?: string;
  sortPriority?: number;
  imagePath?: string;
}

const wins = (allTestimonials as Testimonial[])
  .filter((t) => t.category === "career-outcome" && t.tagline)
  .sort((a, b) => (a.sortPriority ?? Infinity) - (b.sortPriority ?? Infinity))
  .slice(0, 8);

const initials = (name: string) =>
  name
    .split(" ")
    .slice(0, 2)
    .map((p) => p[0])
    .join("")
    .toUpperCase();
---

<section id="wins" class="bg-white py-20 md:py-28">
  <div class="mx-auto max-w-[1100px] px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <p data-cc-fade class="text-sm font-semibold uppercase tracking-[0.2em] text-blue">Member wins</p>
      <h2 data-cc-fade class="mx-auto mt-4 max-w-[20ch] font-display text-[clamp(1.75rem,3.5vw,2.75rem)] leading-tight text-navy">
        Real people. Real offers. Real raises.
      </h2>
      <p data-cc-fade class="mx-auto mt-4 max-w-[52ch] text-[1.0625rem] leading-relaxed text-text-muted">
        These are the kinds of breakthroughs that happen when you stop searching alone.
      </p>
    </div>

    <div data-cc-stagger class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {wins.map((t, i) => (
        <figure
          data-cc-tilt
          class:list={[
            "flex flex-col rounded-3xl border border-border bg-gradient-to-br from-white to-blue-bg/30 p-7 shadow-card transition-shadow hover:shadow-card-hover",
            i === 0 && "lg:col-span-2 lg:row-span-1",
          ]}
        >
          <p class="font-display text-[clamp(1.35rem,2vw,1.75rem)] leading-snug text-navy">
            &ldquo;{t.tagline}&rdquo;
          </p>
          <blockquote class="mt-4 flex-1 text-[0.975rem] leading-[1.7] text-text-muted">
            {t.pullQuote ?? t.quote}
          </blockquote>
          <figcaption class="mt-6 flex items-center gap-3 border-t border-border pt-5">
            {t.imagePath ? (
              <img src={t.imagePath} alt={t.name} width="44" height="44" loading="lazy" class="h-11 w-11 rounded-full object-cover" />
            ) : (
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-blue text-sm font-semibold text-white">{initials(t.name)}</span>
            )}
            <span>
              <span class="block text-sm font-semibold text-navy">{t.name}</span>
              <span class="block text-xs text-text-muted">{t.role}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>

    <p data-cc-fade class="mt-10 text-center text-sm text-text-muted">
      <a href="/testimonials" class="font-semibold text-blue underline-offset-2 hover:underline">Read all 79+ member stories &rarr;</a>
    </p>
  </div>
</section>
