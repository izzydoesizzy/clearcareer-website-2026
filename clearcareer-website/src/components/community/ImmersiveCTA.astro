---
interface Props {
  joinUrl: string;
}
const { joinUrl } = Astro.props;
---

<section class="cc-final relative flex min-h-[80vh] items-center overflow-hidden bg-navy">
  <div class="cc-final-bg absolute inset-0" aria-hidden="true"></div>
  <div class="absolute inset-0" aria-hidden="true" style="background: radial-gradient(70% 70% at 50% 50%, transparent 30%, rgba(3,6,32,0.7) 100%);"></div>

  <div class="relative z-10 mx-auto w-full max-w-[840px] px-4 py-24 text-center sm:px-6 lg:px-8">
    <p data-cc-fade class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-light">The doors are open</p>
    <h2 data-cc-reveal class="mx-auto mt-5 max-w-[16ch] font-display text-[clamp(2.25rem,6vw,4.5rem)] leading-[1.0] text-white">
      Your next role starts in good company.
    </h2>
    <p data-cc-fade data-cc-delay="150" class="mx-auto mt-6 max-w-[50ch] text-lg leading-relaxed text-white/70">
      Join the founding cohort today, lock in $29/mo for life, and never run your job search alone again.
    </p>
    <div data-cc-fade data-cc-delay="300" class="mt-10">
      <a
        href={joinUrl}
        data-magnetic
        class="group inline-flex items-center gap-2 rounded-full bg-white px-9 py-4 text-base font-semibold text-navy shadow-[0_0_60px_-8px_rgba(120,170,255,0.8)] transition-colors hover:bg-blue hover:text-white"
      >
        Become a founding member
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
      <p class="mt-5 text-sm text-white/50">$29/mo · Normally $49 · Cancel anytime</p>
    </div>
  </div>
</section>

<style>
  .cc-final-bg {
    background:
      radial-gradient(55% 50% at 25% 30%, rgba(1, 97, 239, 0.5) 0%, transparent 60%),
      radial-gradient(50% 55% at 80% 70%, rgba(6, 182, 212, 0.4) 0%, transparent 60%),
      radial-gradient(60% 60% at 60% 20%, rgba(59, 130, 246, 0.3) 0%, transparent 60%),
      #030620;
    background-size: 200% 200%;
    animation: cc-final-pan 18s ease-in-out infinite alternate;
  }
  @keyframes cc-final-pan {
    0% { background-position: 0% 0%; }
    100% { background-position: 100% 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cc-final-bg { animation: none; }
  }
</style>
